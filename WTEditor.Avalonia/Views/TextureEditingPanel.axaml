<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             xmlns:controls="using:WTEditor.Avalonia.Controls"
             x:Class="WTEditor.Avalonia.Views.TextureEditingPanel"
             x:DataType="vm:TextureEditingViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Controls/BrushToolSliderStyles.axaml"/>
    <Style Selector="TextBlock.panel-heading">
      <Setter Property="Foreground" Value="#F3F7FA"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#BFD0DC"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#91A5B5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#F51C232B" BorderBrush="#526170" BorderThickness="1" CornerRadius="6">
    <Grid Margin="13" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="panel-heading" Text="Texture tools" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Content="×" Width="26" Height="26" Padding="0"
                Background="Transparent" Foreground="#BFD0DC" BorderThickness="0"
                Command="{Binding TogglePanelCommand}" ToolTip.Tip="Hide texture tools"/>
      </Grid>

      <StackPanel Grid.Row="1" Spacing="6">
        <TextBlock Classes="section-label" Text="TOOL"/>
        <controls:ToolSubModeSelector ItemsSource="{Binding SubModes}"
                                      SelectedItem="{Binding SelectedSubMode}"/>
      </StackPanel>

      <controls:BrushSettingsControl Grid.Row="2" DataContext="{Binding Brush}"/>

      <StackPanel Grid.Row="3" Spacing="4">
        <TextBlock Classes="section-label" Text="TOOL SETTINGS"/>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
          <TextBlock Text="Opacity" Foreground="#9FB1BD" FontSize="11" VerticalAlignment="Center"
                     IsVisible="{Binding IsOpacityVisible}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding IsOpacityVisible}">
            <Slider Value="{Binding Opacity}" Minimum="{Binding OpacityMinimum}"
                    Maximum="{Binding OpacityMaximum}" TickFrequency="1" IsSnapToTickEnabled="True"
                    Width="118" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Opacity, StringFormat={}{0:0}}" Width="42"
                       Foreground="#DCE7ED" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="Strength" Foreground="#9FB1BD" FontSize="11"
                     VerticalAlignment="Center"/>
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <Slider Value="{Binding Strength}" Minimum="0" Maximum="1" Width="118"
                    VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Strength, StringFormat={}{0:0%}}" Width="42"
                       Foreground="#DCE7ED" FontSize="11" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </StackPanel>

      <controls:TextureSelectionControl Grid.Row="4"/>
    </Grid>
  </Border>
</UserControl>
