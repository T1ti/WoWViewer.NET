<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:WTEditor.Avalonia.Views"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
             x:Class="WTEditor.Avalonia.Views.MainView"
             x:DataType="vm:MainViewModel">
  <UserControl.Styles>
    <Style Selector="Border.editor-panel">
      <Setter Property="Background" Value="#F51C232B"/>
      <Setter Property="BorderBrush" Value="#3E4B57"/>
    </Style>
    <Style Selector="ListBox.mode-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.mode-list ListBoxItem">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style Selector="ListBox.mode-list ListBoxItem:selected">
      <Setter Property="Background" Value="#245F8D"/>
    </Style>
    <Style Selector="TextBlock.panel-heading">
      <Setter Property="Foreground" Value="#F3F7FA"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#91A5B5"/>
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="76,*,300" Background="#11171C">
    <Border Classes="editor-panel" BorderThickness="0,0,1,0" Padding="4,8">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="MODES" Foreground="#718594" FontSize="10"
                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
        <ListBox Grid.Row="1" Classes="mode-list"
                 ItemsSource="{Binding Modes}"
                 SelectedItem="{Binding ActiveMode}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EditorModeViewModel">
              <StackPanel Spacing="3" ToolTip.Tip="{Binding Description}">
                <TextBlock Text="{Binding DisplayName}" Foreground="#EDF4F8"
                           HorizontalAlignment="Center" FontSize="12"/>
                <Border Background="#31404C" CornerRadius="3" Padding="4,1"
                        HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Shortcut}" Foreground="#AFC0CD" FontSize="10"/>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <local:Editor3DView Grid.Column="1" DataContext="{Binding ViewportVM}"/>

    <Border Grid.Column="2" Classes="editor-panel" BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="16,13" BorderBrush="#3E4B57" BorderThickness="0,0,0,1">
          <StackPanel Spacing="3">
            <TextBlock Classes="panel-heading" Text="Inspector"/>
            <TextBlock Classes="muted" Text="Selection mode" FontSize="11"/>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16" Spacing="14">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Inspector.SelectionName}" Foreground="#FFFFFF"
                         FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Classes="muted" Text="{Binding Inspector.SelectionKind}"
                         FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Inspector.Sections}"
                          IsVisible="{Binding Inspector.HasSelection}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:InspectorSectionViewModel">
                  <StackPanel Spacing="8" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Title}" Foreground="#BFD0DC"
                               FontSize="11" FontWeight="Bold"/>
                    <Border Background="#222C34" BorderBrush="#394854"
                            BorderThickness="1" CornerRadius="5" Padding="10,7">
                      <ItemsControl ItemsSource="{Binding Properties}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:InspectorPropertyViewModel">
                            <Grid ColumnDefinitions="100,*" Margin="0,4">
                              <TextBlock Text="{Binding Label}" Foreground="#8FA5B5" FontSize="11"/>
                              <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#EEF4F7"
                                         FontSize="11" TextWrapping="Wrap"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
