<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WTEditor.Avalonia.Views"
        x:Class="WTEditor.Avalonia.Views.ObjectToolsWindow"
        Title="Object tools" Width="850" Height="560"
        MinWidth="500" MinHeight="310"
        CanResize="True" WindowDecorations="BorderOnly"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterOwner"
        Background="#11171C">
  <Grid>
    <views:ObjectEditingPanel/>
    <Border x:Name="WindowDragHandle" Height="42" Margin="0,0,175,0"
            HorizontalAlignment="Stretch" VerticalAlignment="Top"
            Background="#01000000" Cursor="SizeAll"
            PointerPressed="WindowDragHandle_OnPointerPressed"/>
  </Grid>
</Window>
