<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WTEditor.Avalonia.Views"
        x:Class="WTEditor.Avalonia.Views.ErrorMessageWindow"
        x:DataType="views:ErrorMessageWindow"
        Title="Error" Width="440" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22" Spacing="16">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <Button Content="OK" MinWidth="90" HorizontalAlignment="Right" IsDefault="True" Click="Ok_OnClick" />
  </StackPanel>
</Window>
