<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WTEditor.Avalonia.ViewModels"
        x:Class="WTEditor.Avalonia.Views.SettingsWindow"
        x:DataType="vm:ClientSettingsViewModel"
        Title="Editor settings" Width="620" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="WoW.Tools settings" />
    <TabControl MinHeight="260">
      <TabItem Header="Rendering">
        <StackPanel Margin="8" Spacing="10">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="10">
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Ambient light (R,G,B)" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBox Width="60" Text="{Binding AmbientColorR}" PlaceholderText="R" />
              <TextBox Width="60" Text="{Binding AmbientColorG}" PlaceholderText="G" />
              <TextBox Width="60" Text="{Binding AmbientColorB}" PlaceholderText="B" />
            </StackPanel>
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Direct light (R,G,B)" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBox Width="60" Text="{Binding DiffuseColorR}" PlaceholderText="R" />
              <TextBox Width="60" Text="{Binding DiffuseColorG}" PlaceholderText="G" />
              <TextBox Width="60" Text="{Binding DiffuseColorB}" PlaceholderText="B" />
            </StackPanel>
            <CheckBox Grid.Row="2" VerticalAlignment="Center" Content="Enable foreground FPS cap"
                      IsChecked="{Binding IsForegroundFrameRateLimitEnabled}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ViewportFrameRateLimit}"
                           Minimum="30" Maximum="360" Increment="10"
                           IsEnabled="{Binding IsForegroundFrameRateLimitEnabled}"
                           ToolTip.Tip="Renderer cap while the viewport is visible. A minimized window or inactive editor tab uses 1 FPS." />
          </Grid>
          <TextBlock Text="Model viewer lighting uses these ambient and direct light values. The editor viewport uses world lighting."
                     TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
      </TabItem>
      <TabItem Header="General">
        <StackPanel Margin="8" Spacing="10">
          <TextBlock Text="Mouse sensitivity" />
          <NumericUpDown Value="{Binding MouseSensitivity}" Minimum="0.001" Maximum="2"
                         Increment="0.005" FormatString="0.###" HorizontalAlignment="Left" Width="180" />
          <TextBlock Text="Keyboard layout" />
          <ComboBox ItemsSource="{Binding KeyboardLayouts}" SelectedItem="{Binding KeyboardLayout}"
                    HorizontalAlignment="Left" Width="180" />
          <TextBlock TextWrapping="Wrap" Opacity="0.75"
                     Text="Auto detects French layouts as AZERTY; choose a layout explicitly to override detection." />
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" MinWidth="90" Click="Cancel_OnClick" />
      <Button Content="Apply" MinWidth="90" IsDefault="True" Click="Apply_OnClick" />
    </StackPanel>
  </StackPanel>
</Window>
