<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WTEditor.Avalonia.ViewModels"
        x:Class="WTEditor.Avalonia.Views.SettingsWindow"
        x:DataType="vm:ClientSettingsViewModel"
        Title="Editor settings" Width="620" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="WoW.Tools settings" />
    <TabControl x:Name="SettingsTabs" MinHeight="260">
      <TabItem Header="Rendering">
        <StackPanel Margin="8" Spacing="10">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="10">
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Ambient light (R,G,B)" />
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBox Width="60" Text="{Binding AmbientColorR}" PlaceholderText="R" />
              <TextBox Width="60" Text="{Binding AmbientColorG}" PlaceholderText="G" />
              <TextBox Width="60" Text="{Binding AmbientColorB}" PlaceholderText="B" />
            </StackPanel>
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Direct light (R,G,B)" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBox Width="60" Text="{Binding DiffuseColorR}" PlaceholderText="R" />
              <TextBox Width="60" Text="{Binding DiffuseColorG}" PlaceholderText="G" />
              <TextBox Width="60" Text="{Binding DiffuseColorB}" PlaceholderText="B" />
            </StackPanel>
            <CheckBox Grid.Row="2" VerticalAlignment="Center" Content="Enable foreground FPS cap"
                      IsChecked="{Binding IsForegroundFrameRateLimitEnabled}" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ViewportFrameRateLimit}"
                           Minimum="30" Maximum="360" Increment="10"
                           IsEnabled="{Binding IsForegroundFrameRateLimitEnabled}"
                           ToolTip.Tip="Renderer cap while the viewport is visible. A minimized window or inactive editor tab uses 1 FPS." />
          </Grid>
          <TextBlock Text="Model viewer lighting uses these ambient and direct light values. The editor viewport uses world lighting."
                     TextWrapping="Wrap" Opacity="0.75" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Client Rendering" x:Name="ClientRenderingTab">
        <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="8" Spacing="12">
            <TextBlock Text="3.3.5 client rendering options" FontWeight="SemiBold" />
            <TextBlock Text="Ultra is the default. Grayed-out options are saved but not used by the renderer yet. Client settings can be edited in either viewport rendering mode."
                       TextWrapping="Wrap" Opacity="0.75" />
            <StackPanel Spacing="4">
              <DockPanel>
                <TextBlock Text="Quality" />
                <TextBlock Text="{Binding ClientQualityLabel}" HorizontalAlignment="Right" />
              </DockPanel>
              <Slider x:Name="ClientQualitySlider" Minimum="1" Maximum="6" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding ClientRenderingQuality}"
                      IsEnabled="False"
                      ToolTip.Tip="Lower quality presets have not been implemented yet." />
              <DockPanel>
                <TextBlock Text="Low" Opacity="0.75" />
                <TextBlock Text="Ultra" HorizontalAlignment="Right" Opacity="0.75" />
              </DockPanel>
            </StackPanel>
            <Grid ColumnDefinitions="220,*,90" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="View distance (farclip)" />
              <Slider x:Name="ClientFarClipSlider" Grid.Column="1"
                      Minimum="183.33333" Maximum="1277" TickFrequency="109.366667"
                      IsSnapToTickEnabled="True" Value="{Binding WrathFarClip}"
                      ToolTip.Tip="Client farclip in world units. The client applies a map-dependent upper limit." />
              <NumericUpDown Grid.Column="2" Value="{Binding WrathFarClip}"
                             Minimum="183.33333" Maximum="1277" Increment="109.366667" FormatString="0.###" />
              <CheckBox Grid.Row="1" Grid.ColumnSpan="3" Content="Extended view distance (farClipOverride)"
                        IsChecked="{Binding WrathFarClipOverride}"
                        ToolTip.Tip="Permits the extended farclip range on older maps." />
            </Grid>
            <Grid ColumnDefinitions="220,*,90" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8" IsEnabled="False">
              <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Terrain texture detail (TerrainMip)" />
              <Slider x:Name="ClientTerrainMipSlider" Grid.Row="0" Grid.Column="1"
                      Minimum="0" Maximum="1" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding TerrainMip}" IsEnabled="False"
                      ToolTip.Tip="TerrainMip: not used by the renderer yet." />
              <NumericUpDown Grid.Row="0" Grid.Column="2" Value="{Binding TerrainMip}" IsEnabled="False"
                             Minimum="0" Maximum="1" Increment="1" FormatString="0" />
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Particle density" />
              <Slider x:Name="ClientParticleDensitySlider" Grid.Row="1" Grid.Column="1"
                      Minimum="0.1" Maximum="1" TickFrequency="0.1"
                      IsSnapToTickEnabled="True" Value="{Binding ParticleDensity}" IsEnabled="False"
                      ToolTip.Tip="ParticleDensity: not used by the renderer yet." />
              <NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding ParticleDensity}" IsEnabled="False"
                             Minimum="0.1" Maximum="1" Increment="0.1" FormatString="0.##" />
              <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Environment detail" />
              <Slider x:Name="ClientEnvironmentDetailSlider" Grid.Row="2" Grid.Column="1"
                      Minimum="0.5" Maximum="1.5" TickFrequency="0.25"
                      IsSnapToTickEnabled="True" Value="{Binding EnvironmentDetail}" IsEnabled="False"
                      ToolTip.Tip="EnvironmentDetail: not used by the renderer yet." />
              <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding EnvironmentDetail}" IsEnabled="False"
                             Minimum="0.5" Maximum="1.5" Increment="0.25" FormatString="0.##" />
              <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Ground clutter density" />
              <Slider x:Name="ClientGroundEffectDensitySlider" Grid.Row="3" Grid.Column="1"
                      Minimum="16" Maximum="64" TickFrequency="8"
                      IsSnapToTickEnabled="True" Value="{Binding GroundEffectDensity}" IsEnabled="False"
                      ToolTip.Tip="GroundEffectDensity: not used by the renderer yet." />
              <NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding GroundEffectDensity}" IsEnabled="False"
                             Minimum="16" Maximum="64" Increment="8" FormatString="0" />
              <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Ground clutter radius" />
              <Slider x:Name="ClientGroundEffectDistSlider" Grid.Row="4" Grid.Column="1"
                      Minimum="70" Maximum="140" TickFrequency="10"
                      IsSnapToTickEnabled="True" Value="{Binding GroundEffectDist}" IsEnabled="False"
                      ToolTip.Tip="GroundEffectDist: not used by the renderer yet." />
              <NumericUpDown Grid.Row="4" Grid.Column="2" Value="{Binding GroundEffectDist}" IsEnabled="False"
                             Minimum="70" Maximum="140" Increment="10" FormatString="0" />
              <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Texture detail (BaseMip)" />
              <Slider x:Name="ClientBaseMipSlider" Grid.Row="5" Grid.Column="1"
                      Minimum="0" Maximum="1" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding BaseMip}" IsEnabled="False"
                      ToolTip.Tip="BaseMip: not used by the renderer yet." />
              <NumericUpDown Grid.Row="5" Grid.Column="2" Value="{Binding BaseMip}" IsEnabled="False"
                             Minimum="0" Maximum="1" Increment="1" FormatString="0" />
              <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Shadow quality" />
              <Slider x:Name="ClientExtShadowQualitySlider" Grid.Row="6" Grid.Column="1"
                      Minimum="0" Maximum="4" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding ExtShadowQuality}" IsEnabled="False"
                      ToolTip.Tip="ExtShadowQuality: not used by the renderer yet." />
              <NumericUpDown Grid.Row="6" Grid.Column="2" Value="{Binding ExtShadowQuality}" IsEnabled="False"
                             Minimum="0" Maximum="4" Increment="1" FormatString="0" />
              <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Anisotropic filtering" />
              <Slider x:Name="ClientTextureFilteringModeSlider" Grid.Row="7" Grid.Column="1"
                      Minimum="0" Maximum="5" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding TextureFilteringMode}" IsEnabled="False"
                      ToolTip.Tip="TextureFilteringMode: not used by the renderer yet." />
              <NumericUpDown Grid.Row="7" Grid.Column="2" Value="{Binding TextureFilteringMode}" IsEnabled="False"
                             Minimum="0" Maximum="5" Increment="1" FormatString="0" />
              <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Weather detail" />
              <Slider x:Name="ClientWeatherDensitySlider" Grid.Row="8" Grid.Column="1"
                      Minimum="0" Maximum="3" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding WeatherDensity}" IsEnabled="False"
                      ToolTip.Tip="WeatherDensity: not used by the renderer yet." />
              <NumericUpDown Grid.Row="8" Grid.Column="2" Value="{Binding WeatherDensity}" IsEnabled="False"
                             Minimum="0" Maximum="3" Increment="1" FormatString="0" />
              <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="Player detail" />
              <Slider x:Name="ClientComponentTextureLevelSlider" Grid.Row="9" Grid.Column="1"
                      Minimum="8" Maximum="9" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding ComponentTextureLevel}" IsEnabled="False"
                      ToolTip.Tip="ComponentTextureLevel: not used by the renderer yet." />
              <NumericUpDown Grid.Row="9" Grid.Column="2" Value="{Binding ComponentTextureLevel}" IsEnabled="False"
                             Minimum="8" Maximum="9" Increment="1" FormatString="0" />
            </Grid>
            <WrapPanel>
              <CheckBox Margin="0,0,16,8" Content="Terrain highlights (specular)"
                        IsChecked="{Binding Specular}" IsEnabled="False" />
              <CheckBox x:Name="ClientGlowCheckBox" Margin="0,0,16,8" Content="Full-screen glow (ffxGlow)"
                        IsChecked="{Binding FullScreenGlow}"
                        ToolTip.Tip="Controls the 3.3.5 client ffxGlow setting. The editor viewport has a separate glow override." />
              <CheckBox Margin="0,0,16,8" Content="Death effect (ffxDeath)"
                        IsChecked="{Binding FfxDeath}" IsEnabled="False" />
              <CheckBox Margin="0,0,16,8" Content="Projected textures"
                        IsChecked="{Binding ProjectedTextures}" IsEnabled="False" />
            </WrapPanel>
            <Grid ColumnDefinitions="220,*,90" ColumnSpacing="8">
              <TextBlock VerticalAlignment="Center" Text="Cloud detail (SkyCloudLOD)" />
              <Slider Grid.Column="1" Minimum="0" Maximum="3" TickFrequency="1"
                      IsSnapToTickEnabled="True" Value="{Binding SkyCloudLod}" />
              <NumericUpDown Grid.Column="2" Value="{Binding SkyCloudLod}"
                             Minimum="0" Maximum="3" Increment="1" FormatString="0"
                             ToolTip.Tip="Selects 128 to 1024 pixel procedural cloud textures. Only affects the 3.3.5 renderer." />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="General">
        <StackPanel Margin="8" Spacing="10">
          <TextBlock Text="Mouse sensitivity" />
          <NumericUpDown Value="{Binding MouseSensitivity}" Minimum="0.001" Maximum="2"
                         Increment="0.005" FormatString="0.###" HorizontalAlignment="Left" Width="180" />
          <TextBlock Text="Keyboard layout" />
          <ComboBox ItemsSource="{Binding KeyboardLayouts}" SelectedItem="{Binding KeyboardLayout}"
                    HorizontalAlignment="Left" Width="180" />
          <TextBlock TextWrapping="Wrap" Opacity="0.75"
                     Text="Auto detects French layouts as AZERTY; choose a layout explicitly to override detection." />
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" MinWidth="90" Click="Cancel_OnClick" />
      <Button Content="Apply" MinWidth="90" IsDefault="True" Click="Apply_OnClick" />
    </StackPanel>
  </StackPanel>
</Window>
