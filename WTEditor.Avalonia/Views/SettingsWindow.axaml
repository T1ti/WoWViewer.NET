<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WTEditor.Avalonia.ViewModels"
        x:Class="WTEditor.Avalonia.Views.SettingsWindow"
        x:DataType="vm:ClientSettingsViewModel"
        Title="Client settings" Width="620" SizeToContent="Height"
        CanResize="False" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="WoW.Tools settings" />
    <TabControl MinHeight="360">
      <TabItem Header="Client">
        <StackPanel Margin="8" Spacing="10">
          <TextBlock TextWrapping="Wrap" Opacity="0.75"
                     Text="Configure the client files used by the renderer. Build and CDN config values are optional when .build.info contains them." />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Client directory" />
            <TextBox Grid.Row="0" Grid.Column="1" PlaceholderText="C:\World of Warcraft" Text="{Binding WowDirectory}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Product" />
            <TextBox Grid.Row="1" Grid.Column="1" PlaceholderText="wow_classic_era" Text="{Binding WowProduct}" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Build config" />
            <TextBox Grid.Row="2" Grid.Column="1" PlaceholderText="Optional" Text="{Binding BuildConfig}" />
            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="CDN config" />
            <TextBox Grid.Row="3" Grid.Column="1" PlaceholderText="Optional" Text="{Binding CdnConfig}" />
          </Grid>
        </StackPanel>
      </TabItem>
      <TabItem Header="Rendering">
        <StackPanel Margin="8" Spacing="10">
          <TextBlock TextWrapping="Wrap" Opacity="0.75"
                     Text="Tile loading distance is used for both loading and unloading. Larger values increase memory use and streaming work." />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="10">
            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Terrain render distance" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TerrainRenderDistance}" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Tile loading distance" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TileLoadingDistance}" />
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Model render distance" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ModelRenderDistance}" />
            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Movement speed" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MovementSpeed}" />
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Mouse sensitivity" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MouseSensitivity}" />
            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Ambient color (R,G,B)" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBox Width="60" Text="{Binding AmbientColorR}" PlaceholderText="R" />
              <TextBox Width="60" Text="{Binding AmbientColorG}" PlaceholderText="G" />
              <TextBox Width="60" Text="{Binding AmbientColorB}" PlaceholderText="B" />
            </StackPanel>
            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Diffuse color (R,G,B)" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <TextBox Width="60" Text="{Binding DiffuseColorR}" PlaceholderText="R" />
              <TextBox Width="60" Text="{Binding DiffuseColorG}" PlaceholderText="G" />
              <TextBox Width="60" Text="{Binding DiffuseColorB}" PlaceholderText="B" />
            </StackPanel>
          </Grid>
          <WrapPanel Orientation="Horizontal" ItemWidth="180">
            <CheckBox Content="Render terrain (ADT)" IsChecked="{Binding RenderAdt}" />
            <CheckBox Content="Render world models (WMO)" IsChecked="{Binding RenderWmo}" />
            <CheckBox Content="Render doodads (M2)" IsChecked="{Binding RenderM2}" />
            <CheckBox Content="Show bounding boxes" IsChecked="{Binding ShowBoundingBoxes}" />
            <CheckBox Content="Show bounding spheres" IsChecked="{Binding ShowBoundingSpheres}" />
          </WrapPanel>
        </StackPanel>
      </TabItem>
      <TabItem Header="General">
        <StackPanel Margin="8" Spacing="10">
          <TextBlock Text="Keyboard layout" />
          <ComboBox ItemsSource="{Binding KeyboardLayouts}" SelectedItem="{Binding KeyboardLayout}"
                    HorizontalAlignment="Left" Width="180" />
          <TextBlock TextWrapping="Wrap" Opacity="0.75"
                     Text="Auto detects French layouts as AZERTY; choose a layout explicitly to override detection." />
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" MinWidth="90" Click="Cancel_OnClick" />
      <Button Content="Apply" MinWidth="90" IsDefault="True" Click="Apply_OnClick" />
    </StackPanel>
  </StackPanel>
</Window>
