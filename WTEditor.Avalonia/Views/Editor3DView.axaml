<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             xmlns:icons="using:WTEditor.Avalonia.Presentation"
             xmlns:controls="using:WTEditor.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WTEditor.Avalonia.Views.Editor3DView" x:Name="Root"
             x:DataType="vm:Editor3DViewModel"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="ToggleButton.viewport-tool">
      <Setter Property="Foreground" Value="#D7E2EC"/>
      <Setter Property="Background" Value="#26313B"/>
      <Setter Property="BorderBrush" Value="#4B5B69"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.viewport-tool:checked">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#24669A"/>
      <Setter Property="BorderBrush" Value="#6CB6FF"/>
    </Style>
    <Style Selector="Button.viewport-tool">
      <Setter Property="Foreground" Value="#D7E2EC"/>
      <Setter Property="Background" Value="#26313B"/>
      <Setter Property="BorderBrush" Value="#4B5B69"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Styles>
  <Grid Background="Transparent">
    <!-- Render surface -->
    <controls:Dx11View Focusable="False"
                       RenderActivity="{Binding RenderActivity, ElementName=Root}"/>

    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="14,10" CornerRadius="4" Background="#D0181B20" ZIndex="20"
            IsVisible="{Binding IsRendererStatusVisible}"
            IsHitTestVisible="False">
      <StackPanel Spacing="4" MaxWidth="520">
        <TextBlock Foreground="White" FontWeight="SemiBold"
                   Text="{Binding RendererStatusMessage}" TextAlignment="Center"/>
        <TextBlock Foreground="#FFFF8A80" Text="{Binding RendererError}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Overlay UI -->
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
            Padding="8" Background="#99000000" ZIndex="10"
            IsHitTestVisible="False">
      <StackPanel Spacing="2">

        <TextBlock Foreground="White" Text="{Binding Fps, StringFormat='FPS: {0:F1}'}" />
        <TextBlock Foreground="White" Text="{Binding FrameTime, StringFormat='Engine CPU: {0:F2} ms'}"/>
        <TextBlock Foreground="White" Text="{Binding PresentationInterval, StringFormat='Viewport interval: {0:F2} ms'}"/>

        <TextBlock Foreground="White" Text="{Binding DrawCalls, StringFormat='Draw Calls: {0}'}"/>
        <TextBlock Foreground="White" Text="{Binding SubmittedTriangleCount, StringFormat='Triangles submitted: {0:N0}'}"/>

        <TextBlock Foreground="White" Text="{Binding CameraClientPosition, StringFormat='Client position: {0}'}"/>
        <TextBlock Foreground="White" Text="{Binding CameraClientDirection, StringFormat='Direction: {0}'}"/>

      </StackPanel>
    </Border>

    <!-- These controls belong to this world viewport instance. Other viewport types
         can provide their own visibility tools without inheriting these switches. -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
            Padding="5" CornerRadius="7" Background="#E61A2027"
            BorderBrush="#526170" BorderThickness="1" ZIndex="30">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding RenderTerrain}"
                      ToolTip.Tip="Show or hide terrain in this world viewport">
          <PathIcon Width="16" Height="16" Data="{x:Static icons:EditorIcons.Terrain}"/>
        </ToggleButton>
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding RenderWorldModels}"
                      ToolTip.Tip="Show or hide WMO buildings in this world viewport">
          <PathIcon Width="16" Height="16" Data="{x:Static icons:EditorIcons.Wmo}"/>
        </ToggleButton>
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding RenderDoodads}"
                      ToolTip.Tip="Show or hide M2 doodads in this world viewport">
          <PathIcon Width="16" Height="16" Data="{x:Static icons:EditorIcons.Doodad}"/>
        </ToggleButton>
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding ShowTerrainGrid}"
                      ToolTip.Tip="Show terrain chunk boundaries in white and ADT boundaries in red">
          <PathIcon Width="16" Height="16" Data="{x:Static icons:EditorIcons.Grid}"/>
        </ToggleButton>
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding ShowTerrainWireframe}"
                      ToolTip.Tip="Show the terrain triangles; grid lines take priority when both overlays are enabled">
          <PathIcon Width="16" Height="16" Data="{x:Static icons:EditorIcons.Wireframe}"/>
        </ToggleButton>
        <Border Width="1" Margin="3,3" Background="#526170"/>
        <Button Classes="viewport-tool" ToolTip.Tip="Advanced rendering settings for this world viewport">
          <PathIcon Width="16" Height="16" Data="{x:Static icons:EditorIcons.Settings}"/>
          <Button.Flyout>
            <Flyout>
              <Border Padding="12" MinWidth="340" Background="#F21A2027"
                      BorderBrush="#526170" BorderThickness="1" CornerRadius="7">
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Advanced rendering" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                    <TextBlock Text="Navigation" Foreground="#9FB4C6" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" RowSpacing="6">
                      <TextBlock Text="Camera speed" Foreground="#D7E2EC" VerticalAlignment="Center"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding MoveSpeed}" Minimum="1" Maximum="10000" Increment="5"/>
                      <TextBlock Grid.Row="1" Text="Mouse sensitivity" Foreground="#D7E2EC" VerticalAlignment="Center"/>
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MouseSensitivity}"
                                     Minimum="0.001" Maximum="2" Increment="0.005" FormatString="0.###"/>
                    </Grid>
                    <Separator/>
                    <TextBlock Text="Distances and streaming" Foreground="#9FB4C6" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                      <TextBlock Text="Terrain distance" Foreground="#D7E2EC" VerticalAlignment="Center"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding TerrainRenderDistance}"
                                     Minimum="100" Maximum="1000000" Increment="500"/>
                      <TextBlock Grid.Row="1" Text="Model distance" Foreground="#D7E2EC" VerticalAlignment="Center"/>
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ModelRenderDistance}"
                                     Minimum="100" Maximum="1000000" Increment="500"/>
                      <TextBlock Grid.Row="2" Text="Tile loading radius" Foreground="#D7E2EC" VerticalAlignment="Center"/>
                      <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding TileLoadingDistance}"
                                     Minimum="0" Maximum="32" Increment="1" FormatString="0"/>
                    </Grid>
                    <Separator/>
                    <TextBlock Text="Level of detail" Foreground="#9FB4C6" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" RowSpacing="6">
                      <TextBlock Text="Minimum model pixels" Foreground="#D7E2EC" VerticalAlignment="Center"
                                 ToolTip.Tip="Cull models below this projected diameter; 0 disables size culling"/>
                      <NumericUpDown Grid.Column="1" Value="{Binding MinimumModelScreenSizePixels}"
                                     Minimum="0" Maximum="16" Increment="0.25" FormatString="0.##"/>
                      <TextBlock Grid.Row="1" Text="Terrain LOD pixels" Foreground="#D7E2EC" VerticalAlignment="Center"
                                 ToolTip.Tip="Use the reduced terrain mesh below this projected chunk diameter; 0 disables it"/>
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TerrainLodTransitionPixels}"
                                     Minimum="0" Maximum="256" Increment="4" FormatString="0"/>
                    </Grid>
                    <Separator/>
                    <TextBlock Text="Diagnostics" Foreground="#9FB4C6" FontWeight="SemiBold"/>
                    <CheckBox Content="Show bounding boxes" IsChecked="{Binding ShowBoundingBoxes}" Foreground="#D7E2EC"/>
                    <CheckBox Content="Show bounding spheres" IsChecked="{Binding ShowBoundingSpheres}" Foreground="#D7E2EC"/>
                    <CheckBox Content="WMO portal culling" IsChecked="{Binding WmoPortalCullingEnabled}" Foreground="#D7E2EC"/>
                    <TextBlock Text="Portal culling is experimental for this client build."
                               Foreground="#9FB4C6" FontSize="11" TextWrapping="Wrap" MaxWidth="310"/>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Border Width="1" Margin="3,3" Background="#526170"/>
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding IsMetricsPanelVisible}"
                      ToolTip.Tip="Show the profiler for this world viewport">
          <PathIcon Width="16" Height="16" Data="{x:Static icons:EditorIcons.Metrics}"/>
        </ToggleButton>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
