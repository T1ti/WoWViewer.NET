<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             xmlns:controls="using:WTEditor.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WTEditor.Avalonia.Views.Editor3DView"
             x:DataType="vm:Editor3DViewModel"
             Focusable="True">
  <UserControl.Styles>
    <Style Selector="ToggleButton.viewport-tool">
      <Setter Property="Foreground" Value="#D7E2EC"/>
      <Setter Property="Background" Value="#26313B"/>
      <Setter Property="BorderBrush" Value="#4B5B69"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
    </Style>
    <Style Selector="ToggleButton.viewport-tool:checked">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="#24669A"/>
      <Setter Property="BorderBrush" Value="#6CB6FF"/>
    </Style>
    <Style Selector="Button.viewport-tool">
      <Setter Property="Foreground" Value="#D7E2EC"/>
      <Setter Property="Background" Value="#26313B"/>
      <Setter Property="BorderBrush" Value="#4B5B69"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
    </Style>
  </UserControl.Styles>
  <Grid Background="Transparent">
    <!-- Render surface -->
    <controls:Dx11View Focusable="False"/>

    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
            Padding="14,10" CornerRadius="4" Background="#D0181B20" ZIndex="20"
            IsVisible="{Binding IsRendererStatusVisible}"
            IsHitTestVisible="False">
      <StackPanel Spacing="4" MaxWidth="520">
        <TextBlock Foreground="White" FontWeight="SemiBold"
                   Text="{Binding RendererStatusMessage}" TextAlignment="Center"/>
        <TextBlock Foreground="#FFFF8A80" Text="{Binding RendererError}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Overlay UI -->
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
            Padding="8" Background="#99000000" ZIndex="10"
            IsHitTestVisible="False">
      <StackPanel Spacing="2">

        <TextBlock Foreground="White" Text="{Binding Fps, StringFormat='FPS: {0:F1}'}" />
        <TextBlock Foreground="White" Text="{Binding FrameTime, StringFormat='Frame: {0:F2} ms'}"/>

        <TextBlock Foreground="White" Text="{Binding DrawCalls, StringFormat='Draw Calls: {0}'}"/>
        <TextBlock Foreground="White" Text="{Binding SubmittedTriangleCount, StringFormat='Triangles submitted: {0:N0}'}"/>

        <TextBlock Foreground="White" Text="{Binding CameraPosition}"/>
        <TextBlock Foreground="White" Text="{Binding CameraDirection, StringFormat='Direction: {0}'}"/>

      </StackPanel>
    </Border>

    <StackPanel
        HorizontalAlignment="Right"
        Margin="10"
        IsHitTestVisible="True"
        Background="Transparent"
        Focusable="False">
      <TextBlock Foreground="White" Text="Speed"/>
      <Slider Value="{Binding MoveSpeed}" Minimum="1" Maximum="500" />
      
      <TextBlock Foreground="White" Text="Sensitivity"/>
      <Slider Value="{Binding MouseSensitivity}" Minimum="0.001" Maximum="0.5" />
    </StackPanel>

    <!-- These controls belong to this world viewport instance. Other viewport types
         can provide their own visibility tools without inheriting these switches. -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
            Padding="5" CornerRadius="7" Background="#E61A2027"
            BorderBrush="#526170" BorderThickness="1" ZIndex="30">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding RenderTerrain}"
                      ToolTip.Tip="Show or hide terrain in this world viewport">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="M2,20 L9,8 L13,14 L16,10 L22,20 Z M8,20 L13,12 L18,20 Z"/>
            <TextBlock Text="Terrain"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding RenderWorldModels}"
                      ToolTip.Tip="Show or hide WMO buildings in this world viewport">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="M3,21 L3,7 L12,2 L21,7 L21,21 Z M8,21 L8,12 L11,12 L11,21 M15,21 L15,12 L18,12 L18,21"/>
            <TextBlock Text="WMO"/>
          </StackPanel>
        </ToggleButton>
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding RenderDoodads}"
                      ToolTip.Tip="Show or hide M2 doodads in this world viewport">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="M12,2 L21,7 L21,17 L12,22 L3,17 L3,7 Z M3,7 L12,12 L21,7 M12,12 L12,22"/>
            <TextBlock Text="M2"/>
          </StackPanel>
        </ToggleButton>
        <Border Width="1" Margin="3,3" Background="#526170"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5" Margin="5,0">
          <TextBlock Text="Min model px" Foreground="#D7E2EC" VerticalAlignment="Center"
                     ToolTip.Tip="Cull WMO and M2 bounding spheres whose projected diameter is smaller than this value; 0 disables size culling"/>
          <Slider Width="90" Minimum="0" Maximum="8" TickFrequency="0.5"
                  Value="{Binding MinimumModelScreenSizePixels}"/>
          <TextBlock Width="28" Foreground="#FFFFFF" VerticalAlignment="Center"
                     Text="{Binding MinimumModelScreenSizePixels, StringFormat='{}{0:F1}'}"/>
        </StackPanel>
        <Border Width="1" Margin="3,3" Background="#526170"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5" Margin="5,0">
          <TextBlock Text="Terrain LOD px" Foreground="#D7E2EC" VerticalAlignment="Center"
                     ToolTip.Tip="Use the half-index terrain mesh below this projected chunk diameter; 0 disables terrain LOD"/>
          <Slider Width="90" Minimum="0" Maximum="128" TickFrequency="8"
                  Value="{Binding TerrainLodTransitionPixels}"/>
          <TextBlock Width="30" Foreground="#FFFFFF" VerticalAlignment="Center"
                     Text="{Binding TerrainLodTransitionPixels, StringFormat='{}{0:F0}'}"/>
        </StackPanel>
        <Border Width="1" Margin="3,3" Background="#526170"/>
        <Button Classes="viewport-tool" ToolTip.Tip="Advanced rendering settings for this world viewport">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="M12,8.5 A3.5,3.5 0 1 0 12,15.5 A3.5,3.5 0 1 0 12,8.5 M12,2 L13.3,4.1 L15.8,4.6 L17.8,3.2 L20.8,6.2 L19.4,8.2 L19.9,10.7 L22,12 L19.9,13.3 L19.4,15.8 L20.8,17.8 L17.8,20.8 L15.8,19.4 L13.3,19.9 L12,22 L10.7,19.9 L8.2,19.4 L6.2,20.8 L3.2,17.8 L4.6,15.8 L4.1,13.3 L2,12 L4.1,10.7 L4.6,8.2 L3.2,6.2 L6.2,3.2 L8.2,4.6 L10.7,4.1 Z"/>
            <TextBlock Text="Advanced"/>
          </StackPanel>
          <Button.Flyout>
            <Flyout>
              <Border Padding="12" MinWidth="280" Background="#F21A2027"
                      BorderBrush="#526170" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="8">
                  <TextBlock Text="Advanced rendering" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                  <CheckBox Content="WMO portal culling"
                            IsChecked="{Binding WmoPortalCullingEnabled}"
                            Foreground="#D7E2EC"/>
                  <TextBlock Text="Experimental for this client build. Disabled by default because some outdoor WMO groups are tagged as interiors."
                             Foreground="#9FB4C6" FontSize="11" TextWrapping="Wrap" MaxWidth="300"/>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Border Width="1" Margin="3,3" Background="#526170"/>
        <ToggleButton Classes="viewport-tool" IsChecked="{Binding IsMetricsPanelVisible}"
                      ToolTip.Tip="Show the profiler for this world viewport">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Width="16" Height="16" Data="M3,20 L3,13 L7,13 L7,20 M10,20 L10,8 L14,8 L14,20 M17,20 L17,3 L21,3 L21,20"/>
            <TextBlock Text="Profiler"/>
          </StackPanel>
        </ToggleButton>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
