<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             xmlns:controls="using:WTEditor.Avalonia.Controls"
             x:Class="WTEditor.Avalonia.Views.TerrainEditingPanel"
             x:DataType="vm:TerrainEditingViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Controls/BrushToolSliderStyles.axaml"/>
    <Style Selector="TextBlock.panel-heading">
      <Setter Property="Foreground" Value="#F3F7FA"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#BFD0DC"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#91A5B5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#F51C232B" BorderBrush="#526170" BorderThickness="1" CornerRadius="6">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="13" Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="panel-heading" Text="Terrain tools" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="×" Width="26" Height="26" Padding="0"
                  Background="Transparent" Foreground="#BFD0DC" BorderThickness="0"
                  Command="{Binding TogglePanelCommand}" ToolTip.Tip="Hide terrain tools"/>
        </Grid>

        <StackPanel Spacing="6">
          <TextBlock Classes="section-label" Text="SUBMODE"/>
          <controls:ToolSubModeSelector ItemsSource="{Binding SubModes}"
                                        SelectedItem="{Binding SelectedSubMode}"/>
        </StackPanel>

        <controls:BrushSettingsControl DataContext="{Binding Brush}"/>

        <StackPanel Spacing="6">
          <TextBlock Classes="section-label" Text="TOOL SETTINGS"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Speed" Foreground="#9FB1BD" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <controls:NonlinearSlider Value="{Binding Speed}" Minimum="{Binding SpeedMinimum}"
                                        Maximum="{Binding SpeedMaximum}" Curve="{Binding SpeedCurve}"
                                        Width="118" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Speed, StringFormat={}{0:0.0}}" Width="42" Foreground="#DCE7ED" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsFlattenSelected}" Spacing="6">
          <TextBlock Classes="section-label" Text="FLATTEN TARGET"/>
          <ComboBox ItemsSource="{Binding FlattenTargets}" SelectedIndex="{Binding FlattenTarget}"
                    HorizontalAlignment="Stretch"
                    ToolTip.Tip="Brush centre samples the height when the stroke starts and keeps that target while dragging."/>
          <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsFixedFlattenHeight}">
            <TextBlock Text="Height" Foreground="#9FB1BD" FontSize="11" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding FlattenHeight}" Increment="0.5" FormatString="0.0" Width="92"/>
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsSmoothSelected}" Spacing="6">
          <TextBlock Classes="section-label" Text="SMOOTHING"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Iterations" Foreground="#9FB1BD" FontSize="11" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding SmoothIterations}" Minimum="1" Maximum="8" Increment="1" Width="92"/>
          </Grid>
        </StackPanel>

        <Border Background="#1B3038" BorderBrush="#315E6B" BorderThickness="1" CornerRadius="4" Padding="8">
          <TextBlock Text="Move over terrain to position the brush. Hold Shift or Control with the left mouse button to edit."
                     Foreground="#9FC0CA" FontSize="10" TextWrapping="Wrap"/>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
