<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WTEditor.Avalonia.App"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             xmlns:views="using:WTEditor.Avalonia.Views"
             RequestedThemeVariant="Dark">
             <!-- Use the dark Fluent theme so popups and form controls match the editor surface. -->

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:MainViewModel}">
            <views:MainView/>
        </DataTemplate>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
