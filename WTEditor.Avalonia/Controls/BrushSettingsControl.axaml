<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             xmlns:controls="using:WTEditor.Avalonia.Controls"
             xmlns:icons="using:WTEditor.Avalonia.Presentation"
             x:Class="WTEditor.Avalonia.Controls.BrushSettingsControl"
             x:DataType="vm:BrushSettingsViewModel">
  <UserControl.Styles>
    <StyleInclude Source="/Controls/BrushToolSliderStyles.axaml"/>
    <Style Selector="TextBlock.section-label">
      <Setter Property="Foreground" Value="#BFD0DC"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="ListBox.brush-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.brush-list ListBoxItem">
      <Setter Property="Background" Value="#1B242B"/>
      <Setter Property="Foreground" Value="#DCE7ED"/>
      <Setter Property="BorderBrush" Value="#394854"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="3"/>
      <Setter Property="Margin" Value="0,0,5,4"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Width" Value="50"/>
      <Setter Property="Height" Value="50"/>
    </Style>
    <Style Selector="ListBox.brush-list ListBoxItem:selected">
      <Setter Property="Background" Value="#294B5A"/>
      <Setter Property="BorderBrush" Value="#65AFC4"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#222C34" BorderBrush="#394854" BorderThickness="1" CornerRadius="5" Padding="9">
    <StackPanel Spacing="5">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <TextBlock Classes="section-label" Text="BRUSH" VerticalAlignment="Center"/>
        <PathIcon Data="{x:Static icons:EditorIcons.Information}" Width="12" Height="12" Foreground="#91A5B5"
                  ToolTip.Tip="White is full influence; black is zero. Falloff is shown only when the tool and preset use it."/>
      </StackPanel>
      <ListBox Classes="brush-list" ItemsSource="{Binding AvailableBrushes}" SelectedItem="{Binding SelectedBrush}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BrushPresetViewModel">
            <controls:BrushMaskPreview Preset="{Binding}" Width="38" Height="38" ClipToBounds="True"
                                       ToolTip.Tip="{Binding Description}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="{Binding SelectedBrush.DisplayName}" Foreground="#DCE7ED" FontSize="11" FontWeight="SemiBold"
                 ToolTip.Tip="{Binding SelectedBrush.Description}"/>

      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
        <TextBlock Text="Size" Foreground="#9FB1BD" FontSize="11" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <controls:NonlinearSlider Value="{Binding Size}" Minimum="{Binding SizeMinimum}"
                                    Maximum="{Binding SizeMaximum}" Curve="{Binding SizeCurve}"
                                    Width="118" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Size, StringFormat={}{0:0.0}}" Width="42" Foreground="#DCE7ED" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Falloff" Foreground="#9FB1BD" FontSize="11" VerticalAlignment="Center"
                   IsVisible="{Binding IsFalloffVisible}"/>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                    IsVisible="{Binding IsFalloffVisible}">
          <Slider Value="{Binding Falloff}" Minimum="0" Maximum="1" Width="118" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding Falloff, StringFormat={}{0:0%}}" Width="34" Foreground="#DCE7ED" FontSize="11" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
