<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WTEditor.Avalonia.Controls"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             x:Class="WTEditor.Avalonia.Controls.ToolSubModeSelector"
             x:Name="Root"
             x:DataType="controls:ToolSubModeSelector">
  <UserControl.Styles>
    <Style Selector="ListBox.submode-list">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBox.submode-list ListBoxItem">
      <Setter Property="Background" Value="#222C34"/>
      <Setter Property="Foreground" Value="#DCE7ED"/>
      <Setter Property="BorderBrush" Value="#394854"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.submode-list ListBoxItem:selected">
      <Setter Property="Background" Value="#276B82"/>
      <Setter Property="BorderBrush" Value="#5FB9D2"/>
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="6">
    <ListBox Classes="submode-list"
             ItemsSource="{Binding ItemsSource, ElementName=Root}"
             SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ToolSubModeViewModel">
          <PathIcon Data="{Binding Icon}" Width="20" Height="20"
                    ToolTip.Tip="{Binding Tooltip}"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="{Binding SelectedItem.Description, ElementName=Root}"
               Foreground="#91A5B5" FontSize="11" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
