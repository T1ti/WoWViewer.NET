<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:WTEditor.Avalonia.Controls"
             xmlns:models="using:WTEditor.Application.Models"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             x:Class="WTEditor.Avalonia.Controls.FloatingMetricsPanel"
             x:DataType="vm:Editor3DViewModel"
             MinWidth="360" MinHeight="320">
  <UserControl.Resources>
    <controls:FrameStepBrushConverter x:Key="FrameStepBrushConverter"/>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F2F5F8"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#F2F5F8"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Foreground" Value="#F2F5F8"/>
      <Setter Property="Background" Value="#354250"/>
    </Style>
  </UserControl.Styles>

  <Border Background="#F21A2027" BorderBrush="#607284" BorderThickness="1"
          CornerRadius="7" BoxShadow="0 8 24 0 #99000000" ClipToBounds="True">
    <Grid RowDefinitions="38,*">
      <Border Grid.Row="0" Background="#293440" Padding="10,0">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="16" Height="16" Foreground="#6CB6FF"
                      Data="M2,18 L2,11 L6,11 L6,15 L10,15 L10,7 L14,7 L14,13 L18,13 L18,4 L22,4 L22,18 Z"/>
            <TextBlock Text="Frame profiler" FontWeight="SemiBold"/>
          </StackPanel>
          <TextBlock Grid.Column="1" Text="{Binding PerformanceEnvironmentLabel}" Foreground="#AFC7DC"
                     FontSize="10" Margin="8,0"/>
          <CheckBox Grid.Column="2" Content="Pause" Margin="8,0"
                    IsChecked="{Binding IsProfilingPaused}"/>
          <Button Grid.Column="3" Content="Capture 10 s" Margin="4,0,8,0" Padding="9,3"
                  Command="{Binding StartPerformanceCaptureCommand}"
                  ToolTip.Tip="Waits 2 seconds for GPU timing to settle, then records 10 seconds"/>
          <Button Grid.Column="4" Width="28" Height="26" Padding="0"
                  Command="{Binding CloseMetricsPanelCommand}" ToolTip.Tip="Close profiler">
            <PathIcon Width="12" Height="12" Data="M4,4 L20,20 M20,4 L4,20"/>
          </Button>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12" Spacing="12">
          <Grid ColumnDefinitions="*,*,*">
            <Border Padding="8" Background="#25303A" CornerRadius="4" Margin="0,0,4,0">
              <StackPanel>
                <TextBlock Text="CPU work" Foreground="#AFC7DC" FontSize="11"/>
                <TextBlock FontSize="18" FontWeight="SemiBold"
                           Text="{Binding ProfileCpuMilliseconds, StringFormat='{}{0:F2} ms'}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="8" Background="#302735" CornerRadius="4" Margin="2,0">
              <StackPanel>
                <TextBlock Text="GPU timeline" Foreground="#FF99C7" FontSize="11"/>
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#FF5DA2"
                           Text="{Binding ProfileGpuMilliseconds, StringFormat='{}{0:F2} ms'}"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="8" Background="#25303A" CornerRadius="4" Margin="4,0,0,0">
              <StackPanel>
                <TextBlock Text="Engine frame" Foreground="#AFC7DC" FontSize="11"/>
                <TextBlock FontSize="18" FontWeight="SemiBold"
                           Text="{Binding ProfileFrameMilliseconds, StringFormat='{}{0:F2} ms'}"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Padding="9" CornerRadius="4" Background="#49351F" BorderBrush="#8B642D"
                  BorderThickness="1" IsVisible="{Binding IsPerformanceEnvironmentWarningVisible}">
            <TextBlock Text="Performance captures from Debug builds or with D3D11 validation enabled are diagnostic only. Use Release with validation off for representative timings."
                       Foreground="#FFD18A" FontSize="11" TextWrapping="Wrap"/>
          </Border>

          <Border Padding="9" CornerRadius="4" Background="#352B3A">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding ProfileBottleneck}" Foreground="#FFD166" FontWeight="SemiBold"/>
              <TextBlock Text="Compares CPU frame time with elapsed time between GPU command-stream markers. A slow CPU can leave the GPU idle inside that span, so this is not GPU utilization."
                         Foreground="#C5D0DA" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>
          </Border>

          <Border Padding="9" CornerRadius="4" Background="#20313A" BorderBrush="#365365" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="Timed capture" Foreground="#7CC7F2" FontWeight="SemiBold"/>
              <CheckBox Content="Detailed GPU pass timing (sampled every 8 frames)"
                        IsChecked="{Binding IsDetailedGpuProfilingEnabled}"/>
              <TextBlock Text="{Binding PerformanceCaptureStatus}" Foreground="#D6E5EF"
                         FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="Capture terrain-only, WMO-only, M2-only, then the mixed scene. Do not move the camera or change visibility while a capture is running."
                         Foreground="#AFC0CF" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="Leave detailed timing off for an unperturbed baseline. Enable it only when pass-level GPU timing is needed; CPU pass timings and command counters remain available in both modes."
                         Foreground="#91A4B5" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <StackPanel Spacing="5">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="CPU work and GPU timeline history" FontWeight="SemiBold"/>
              <Button Grid.Column="1" Content="Clear" Padding="8,3"
                      Command="{Binding ClearPerformanceHistoryCommand}"/>
            </Grid>
            <controls:FrameTimelineGraph Height="210" Samples="{Binding PerformanceHistory}"/>
            <TextBlock Text="Each sample has a stacked CPU bar (left) and GPU command-stream timeline bar (right). The graph scales to recent activity; horizontal lines mark visible frame budgets."
                       Foreground="#AFC0CF" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="Latest measured frame" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding CurrentFrameSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="12,*,78" Margin="0,2">
                    <Border Width="8" Height="8" CornerRadius="2"
                            Background="{Binding Name, Converter={StaticResource FrameStepBrushConverter}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="#D7E1E9"
                               Text="{Binding DurationMilliseconds, StringFormat='{}{0:F3} ms'}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="CPU command submission is time spent preparing and issuing D3D11 commands; it is not mesh upload time. GPU spans are elapsed time between command-stream timestamps and may include idle starvation while the CPU submits more commands."
                       Foreground="#AFC0CF" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="Render passes" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding ProfileRenderWorkload.Passes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:RenderPassMetrics">
                  <Border Padding="9" Margin="0,0,0,5" CornerRadius="4" Background="#242D35">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                          <TextBlock Text="GPU span" Foreground="#FF99C7" FontSize="11"/>
                          <TextBlock Text="{Binding GpuMilliseconds, StringFormat='{}{0:F3} ms'}"
                                     Foreground="#FF79B6" FontWeight="SemiBold"/>
                        </StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions="*,*,*,*,*">
                        <StackPanel>
                          <TextBlock Text="CPU cull" Foreground="#AFC7DC" FontSize="10"/>
                          <TextBlock Text="{Binding CpuCullingMilliseconds, StringFormat='{}{0:F3} ms'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="CPU commands" Foreground="#AFC7DC" FontSize="10"/>
                          <TextBlock Text="{Binding CpuSubmissionMilliseconds, StringFormat='{}{0:F3} ms'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Draw calls" Foreground="#AFC7DC" FontSize="10"/>
                          <TextBlock Text="{Binding DrawCalls}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                          <TextBlock Text="{Binding SubmittedItemLabel}" Foreground="#AFC7DC" FontSize="10"/>
                          <TextBlock Text="{Binding SubmittedItems}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                          <TextBlock Text="Indexed triangles" Foreground="#AFC7DC" FontSize="10"/>
                          <TextBlock Text="{Binding SubmittedTriangles, StringFormat='{}{0:N0}'}"/>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="D3D11 command pressure" FontWeight="SemiBold"/>
            <Border Padding="9" CornerRadius="4" Background="#242D35">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Text="Dynamic instance-buffer maps"/>
                <TextBlock Grid.Column="1" Text="{Binding ProfileRenderWorkload.InstanceBufferMaps}"/>
                <TextBlock Grid.Row="1" Text="Constant-buffer updates"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileRenderWorkload.ConstantBufferUpdates}"/>
                <TextBlock Grid.Row="2" Text="Material texture bind calls"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileRenderWorkload.TextureBindingCalls}"/>
                <TextBlock Grid.Row="3" Text="Blend-state bind calls"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileRenderWorkload.BlendStateBindings}"/>
                <TextBlock Grid.Row="4" Text="Vertex-buffer bind calls"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileRenderWorkload.VertexBufferBindings}"/>
                <TextBlock Grid.Row="5" Text="Index-buffer bind calls"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProfileRenderWorkload.IndexBufferBindings}"/>
              </Grid>
            </Border>
            <TextBlock Text="These are API call counts, not bytes transferred. High counts paired with high CPU command time indicate immediate-context or driver overhead."
                       Foreground="#AFC0CF" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>

          <Border Padding="9" CornerRadius="4" Background="#242D35">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Text="Pending streamed resources"/>
              <TextBlock Grid.Column="1" Text="{Binding ProfilePendingAssets}"/>
              <TextBlock Grid.Row="1" Text="Resources uploaded this frame"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileUploadedResources}"/>
              <TextBlock Grid.Row="2" Text="Draw calls submitted"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DrawCalls}"/>
              <TextBlock Grid.Row="3" Text="Indexed triangles submitted"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SubmittedTriangleCount, StringFormat='{}{0:N0}'}"/>
            </Grid>
          </Border>

          <StackPanel Spacing="5">
            <TextBlock Text="Visibility culling" FontWeight="SemiBold"/>
            <Border Padding="9" CornerRadius="4" Background="#242D35">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Text="Terrain chunks visible / loaded candidates"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <TextBlock Text="{Binding ProfileCulling.VisibleTerrainChunks}"/><TextBlock Text=" / "/><TextBlock Text="{Binding ProfileCulling.CandidateTerrainChunks}"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="WMO instances visible / loaded candidates"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                  <TextBlock Text="{Binding ProfileCulling.VisibleWorldModels}"/><TextBlock Text=" / "/><TextBlock Text="{Binding ProfileCulling.CandidateWorldModels}"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="M2 instances visible / loaded candidates"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                  <TextBlock Text="{Binding ProfileCulling.VisibleDoodads}"/><TextBlock Text=" / "/><TextBlock Text="{Binding ProfileCulling.CandidateDoodads}"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="WMO culled below pixel threshold"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileCulling.SizeCulledWorldModels}"/>
                <TextBlock Grid.Row="4" Text="M2 culled below pixel threshold"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileCulling.SizeCulledDoodads}"/>
                <TextBlock Grid.Row="5" Text="Terrain chunks using far LOD"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProfileCulling.FarLodTerrainChunks}"/>
                <TextBlock Grid.Row="6" Text="World tiles coarse-rejected / tested"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                  <TextBlock Text="{Binding ProfileCulling.CoarseCulledTiles}"/><TextBlock Text=" / "/><TextBlock Text="{Binding ProfileCulling.CandidateTiles}"/>
                </StackPanel>
                <TextBlock Grid.Row="7" Text="Terrain chunks culled"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ProfileCulling.CulledTerrainChunks}"/>
                <TextBlock Grid.Row="8" Text="WMO culled by visibility / distance"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ProfileCulling.CulledWorldModels}"/>
                <TextBlock Grid.Row="9" Text="M2 culled by visibility / distance"/>
                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ProfileCulling.CulledDoodads}"/>
              </Grid>
            </Border>
            <TextBlock Text="Candidates are loaded scene items, not draw calls. Instancing and terrain batching can produce few draw calls while submitting many visible triangles."
                       Foreground="#AFC0CF" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="Application process" FontWeight="SemiBold"/>
            <Border Padding="9" CornerRadius="4" Background="#242D35">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                <TextBlock Text="CPU utilization"/>
                <TextBlock Grid.Column="1" Text="{Binding ProfileProcessCpuPercent, StringFormat='{}{0:F1}%'}"/>
                <TextBlock Grid.Row="1" Text="Managed memory"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileManagedMemoryMegabytes, StringFormat='{}{0:F1} MB'}"/>
                <TextBlock Grid.Row="2" Text="Working set"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileWorkingSetMegabytes, StringFormat='{}{0:F1} MB'}"/>
                <TextBlock Grid.Row="3" Text="Managed allocation rate"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfileAllocationMegabytesPerSecond, StringFormat='{}{0:F2} MB/s'}"/>
                <TextBlock Grid.Row="4" Text="Gen 0 collections"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfileGen0Collections}"/>
              </Grid>
            </Border>
          </StackPanel>

          <TextBlock Margin="0,0,8,6"
                     Text="GPU timeline timings arrive several frames late because queries are read without blocking the rendering thread."
                     Foreground="#91A4B5" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
