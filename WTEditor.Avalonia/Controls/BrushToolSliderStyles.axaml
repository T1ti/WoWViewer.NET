<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <!-- Keep the Fluent track centered: 6 + 20px thumb + 6 = 32px. -->
    <GridLength x:Key="SliderPreContentMargin">6</GridLength>
    <GridLength x:Key="SliderPostContentMargin">6</GridLength>
    <x:Double x:Key="SliderHorizontalHeight">32</x:Double>
  </Styles.Resources>
  <Style Selector="Slider">
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Height" Value="32"/>
  </Style>
</Styles>
