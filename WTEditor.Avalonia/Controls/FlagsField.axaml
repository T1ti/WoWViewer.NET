<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             x:Class="WTEditor.Avalonia.Controls.FlagsField"
             x:DataType="vm:FlagsFieldViewModel">
  <Grid RowDefinitions="Auto,Auto" Margin="0,3" ToolTip.Tip="{Binding ToolTip}">
    <TextBlock Text="{Binding Label}" Foreground="#8FA5B5" FontSize="11"/>
    <TextBlock Grid.Row="1" Text="{Binding DisplayText}" Foreground="#EEF4F7"
               FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
  </Grid>
</UserControl>
