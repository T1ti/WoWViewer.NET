<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WTEditor.Avalonia.ViewModels"
             xmlns:icons="using:WTEditor.Avalonia.Presentation"
             x:Class="WTEditor.Avalonia.Controls.TextureBrowserControl"
             x:Name="Root"
             x:DataType="vm:TextureEditingViewModel">
  <UserControl.Resources>
    <DataTemplate x:Key="TextureItemTemplate" x:DataType="vm:TexturePaletteItemViewModel">
      <Grid RowDefinitions="92,*" ToolTip.Tip="{Binding Tooltip}"
            PointerPressed="TextureSlot_OnPointerPressed"
            PointerMoved="TextureSlot_OnPointerMoved"
            PointerReleased="TextureSlot_OnPointerReleased">
        <Grid.ContextMenu>
          <ContextMenu><MenuItem Header="Preview" Command="{Binding PreviewCommand}"/></ContextMenu>
        </Grid.ContextMenu>
        <Border Background="#0B0E11" ClipToBounds="True">
          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,3,3,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="2">
          <Border Width="16" Height="16" CornerRadius="2"
                  Background="#E6232A30" BorderBrush="#A8C4D4" BorderThickness="1"
                  IsVisible="{Binding HasSpecularVariant}"
                  ToolTip.Tip="Specular variant available (_s)">
            <TextBlock Text="s" Foreground="#F3F7FA" FontSize="9" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Border Width="16" Height="16" CornerRadius="2"
                  Background="#E6232A30" BorderBrush="#D3A66B" BorderThickness="1"
                  IsVisible="{Binding HasHeightVariant}"
                  ToolTip.Tip="Height variant available (_h)">
            <TextBlock Text="h" Foreground="#F3F7FA" FontSize="9" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="1,4,1,0" Text="{Binding DisplayName}"
                   Foreground="#EDF4F8" FontSize="9" TextWrapping="Wrap"
                   MaxLines="2" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ListBox.texture-grid">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
    <Style Selector="ListBox.texture-grid ListBoxItem">
      <Setter Property="Width" Value="104"/><Setter Property="Height" Value="124"/>
      <Setter Property="Margin" Value="0,0,7,7"/><Setter Property="Padding" Value="4"/>
      <Setter Property="Background" Value="#11171C"/><Setter Property="BorderBrush" Value="#394854"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="ListBox.texture-grid ListBoxItem:selected">
      <Setter Property="Background" Value="#294B5A"/><Setter Property="BorderBrush" Value="#65AFC4"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Grid.folder-card Button.folder-favorite">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Grid.folder-card:pointerover Button.folder-favorite">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
  </UserControl.Styles>

  <Grid Margin="10" RowDefinitions="Auto,Auto,*" RowSpacing="7">
    <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
      <WrapPanel Orientation="Horizontal">
        <ToggleButton Content="Folders" IsChecked="{Binding Browser.IsExplorerMode}"
                      Padding="9,4" ToolTip.Tip="Toggle file explorer view"/>
        <CheckBox Content="Include specular" Margin="10,0,0,0"
                  IsChecked="{Binding Browser.IncludeSpecularTextures}"
                  Foreground="#BFD0DC" VerticalAlignment="Center"
                  ToolTip.Tip="Include specular texture files ending in _s"/>
      </WrapPanel>
      <TextBox Grid.Row="1" PlaceholderText="Search terrain textures…"
               Text="{Binding Browser.SearchText, Mode=TwoWay}"
               IsVisible="{Binding Browser.IsSimpleMode}"/>
      <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5"
            IsVisible="{Binding Browser.IsExplorerMode}">
        <Button Width="28" Height="28" Padding="5"
                Command="{Binding Browser.NavigateToParentCommand}"
                ToolTip.Tip="Parent folder">
          <PathIcon Data="{x:Static icons:EditorIcons.ParentFolder}" Width="15" Height="15"/>
        </Button>
        <TextBlock Grid.Column="1" Text="{Binding Browser.CurrentFolderPath}"
                   Foreground="#BFD0DC" FontSize="11" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <Button Grid.Column="2" Width="28" Height="28" Padding="5"
                Command="{Binding Browser.SetFolderAsFavoritesCommand}"
                CommandParameter="{Binding Browser.SelectedFolder}"
                IsEnabled="{Binding Browser.SelectedFolder.HasDirectTextures}"
                ToolTip.Tip="Set this folder's textures as favorites (replaces current favorites)">
          <PathIcon Data="{x:Static icons:EditorIcons.ExpansionStar}" Width="15" Height="15"/>
        </Button>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="1" Text="Reading files available in this client…"
               IsVisible="{Binding Browser.IsLoading}" Foreground="#91A5B5" FontSize="10"/>

    <ListBox Grid.Row="2" Classes="texture-grid"
             ItemsSource="{Binding Browser.Results}"
             SelectedItem="{Binding Browser.SelectedSimpleTexture}"
             ItemTemplate="{StaticResource TextureItemTemplate}"
             IsVisible="{Binding Browser.IsSimpleMode}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
    </ListBox>

    <Grid Grid.Row="2" ColumnDefinitions="160,5,*"
          IsVisible="{Binding Browser.IsExplorerMode}">
      <Border Background="#11171C" BorderBrush="#394854" BorderThickness="1"
              CornerRadius="4" Padding="4">
        <TreeView ItemsSource="{Binding Browser.RootFolders}"
                  SelectedItem="{Binding Browser.SelectedFolder, Mode=TwoWay}"
                  Background="Transparent" BorderThickness="0">
          <TreeView.DataTemplates>
            <TreeDataTemplate DataType="vm:TextureBrowserFolderViewModel"
                              ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding FullPath}">
                <PathIcon Data="{x:Static icons:EditorIcons.Folder}"
                          Foreground="#E4B85C" Width="14" Height="14"/>
                <TextBlock Text="{Binding Name}" Foreground="#DCE7ED" FontSize="10"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.DataTemplates>
        </TreeView>
      </Border>

      <GridSplitter Grid.Column="1" Background="#526170"
                    ResizeDirection="Columns"/>

      <Grid Grid.Column="2" Margin="7,0,0,0">
        <ListBox Classes="texture-grid" ItemsSource="{Binding Browser.CurrentEntries}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.DataTemplates>
            <DataTemplate DataType="vm:TextureBrowserFolderViewModel">
              <Grid Classes="folder-card" RowDefinitions="92,*" ToolTip.Tip="{Binding FullPath}"
                    PointerReleased="FolderEntry_OnPointerReleased">
                <Border Background="#182028" ClipToBounds="True">
                  <PathIcon Data="{x:Static icons:EditorIcons.Folder}"
                            Foreground="#E4B85C" Width="48" Height="48"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button Classes="folder-favorite" Width="24" Height="24" Padding="4"
                        Margin="0,3,3,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="#E62C343C" BorderBrush="#81909B" BorderThickness="1"
                        Command="{Binding DataContext.Browser.SetFolderAsFavoritesCommand, ElementName=Root}"
                        CommandParameter="{Binding}" IsEnabled="{Binding HasDirectTextures}"
                        ToolTip.Tip="Set this folder's textures as favorites (replaces current favorites)">
                  <PathIcon Data="{x:Static icons:EditorIcons.ExpansionStar}" Width="13" Height="13"/>
                </Button>
                <TextBlock Grid.Row="1" Margin="1,4,1,0" Text="{Binding Name}"
                           Foreground="#EDF4F8" FontSize="9" TextWrapping="Wrap"
                           MaxLines="2" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
            <DataTemplate DataType="vm:TexturePaletteItemViewModel">
              <ContentControl Content="{Binding}"
                              ContentTemplate="{StaticResource TextureItemTemplate}"/>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
